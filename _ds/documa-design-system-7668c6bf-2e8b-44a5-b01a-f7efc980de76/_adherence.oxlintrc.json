{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/document/**",
              "components/feedback/**",
              "components/forms/**",
              "exploration/landing/**",
              "ui_kits/documa-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|children|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, children, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:base|compact)$/]",
        "message": "<Button> size must be one of 'base' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|token|state|children|key|ref|className|style|children)$/]",
        "message": "<DocSlot> doesn't accept that prop. Declared props: label, token, state, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocSlot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:empty|filling|pending|filled)$/]",
        "message": "<DocSlot> state must be one of 'empty' | 'filling' | 'pending' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropzoneFile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<DropzoneFile> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:token|label|thumbSrc|onPick|key|ref|className|style|children)$/]",
        "message": "<ImagePoint> doesn't accept that prop. Declared props: token, label, thumbSrc, onPick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|token|src|caption|key|ref|className|style|children)$/]",
        "message": "<ImageSlot> doesn't accept that prop. Declared props: label, token, src, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='LimitNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|resetLabel|onReset|visible|key|ref|className|style|children)$/]",
        "message": "<LimitNotice> doesn't accept that prop. Declared props: title, description, resetLabel, onReset, visible."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:recording|supported|onClick|key|ref|className|style|children)$/]",
        "message": "<MicButton> doesn't accept that prop. Declared props: recording, supported, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|remaining|key|ref|className|style|children)$/]",
        "message": "<StampCounter> doesn't accept that prop. Declared props: total, remaining."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemplateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|textSlots|imageSlots|active|onClick|key|ref|className|style|children)$/]",
        "message": "<TemplateCard> doesn't accept that prop. Declared props: name, textSlots, imageSlots, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|listening|minHeight|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: value, onChange, placeholder, listening, minHeight."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
